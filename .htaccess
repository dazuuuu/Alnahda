# Document root on some hosts points here (project root) instead of public/.
# Internally rewrite every request into public/ so public/.htaccess and
# public/index.php handle routing — browser URLs stay unchanged (no /public/).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Real files already under public/ (CSS, JS, images) — serve as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^public/ - [L]

    # Stale /public/... links that are not real files → front controller.
    RewriteRule ^public/(.*)$ public/index.php [QSA,L]

    # Everything else → public/ (then public/.htaccess routes to index.php).
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
