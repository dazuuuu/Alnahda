# Copy this file to .env and fill in real values. Never commit .env.
# Values that contain spaces (e.g. Gmail App Passwords) MUST be double-quoted.

# Used for absolute links in emails. Does NOT control CSS/asset paths
# (those follow the live request so local + production both stay correct).
#
# Local:        APP_URL=http://localhost/Alnahda/public
# Production:   APP_URL=https://alnahdaagency.com
APP_URL=http://localhost/Alnahda/public
APP_NAME="Al NAHDA Agency"
APP_DEBUG=1

# --- Database (AMPPS MySQL default: root / no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alnahda_db
DB_USER=root
DB_PASS=mysql

# --- SMTP (portal login codes, application confirmations, admin emails) ---
# Gmail: use App Password; quote it if it has spaces: MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=Alnahdaagency@gmail.com
MAIL_PASSWORD="your-gmail-app-password"
MAIL_FROM_ADDRESS=Alnahdaagency@gmail.com
MAIL_FROM_NAME="Al NAHDA Agency"

# --- Admin seed account (only used the first time the DB is set up) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
