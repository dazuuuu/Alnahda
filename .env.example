# Copy this file to .env and fill in real values. Never commit .env.
# Values that contain spaces (e.g. Gmail App Passwords like "xxxx xxxx xxxx xxxx")
# MUST be wrapped in double quotes, otherwise phpdotenv will crash on load.

APP_URL=http://localhost/Alnahda/public
APP_NAME="Al NAHDA Agency"
APP_DEBUG=1

# --- Database (AMPPS MySQL default: root / no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alnahda_db
DB_USER=root
DB_PASS=mysql

# --- SMTP (portal login codes, application confirmations, admin note emails) ---
# Gmail example (App Password required when 2FA is on):
#   1. Google Account → Security → 2-Step Verification → App passwords
#   2. Paste the 16-character password below, quoted if it has spaces
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=Alnahdaagency@gmail.com
MAIL_PASSWORD="your-gmail-app-password"
MAIL_FROM_ADDRESS=Alnahdaagency@gmail.com
MAIL_FROM_NAME="Al NAHDA Agency"
# Optional: MAIL_DEBUG=1 logs the SMTP transcript to the PHP error log
# Optional: MAIL_SSL_VERIFY=0 if local AMPPS has broken CA certificates

# --- Admin seed account (only used the first time the DB is set up) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
