# Copy this file to .env and fill in real values. Never commit .env.
# Values that contain spaces (e.g. Gmail App Passwords like "xxxx xxxx xxxx xxxx")
# MUST be wrapped in double quotes, otherwise phpdotenv will crash on load.

APP_URL=http://localhost/Alnahda/public
APP_NAME="Al NAHDA Agency"
APP_DEBUG=1

# --- Database (AMPPS MySQL default: root / no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alnahda_db
DB_USER=root
DB_PASS=mysql

# --- SMTP (used for portal login codes & applicant notifications) ---
# For Gmail: use an App Password, and keep the spaces by quoting it:
# MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@example.com
MAIL_PASSWORD="changeme"
MAIL_FROM_ADDRESS=Alnahdaagency@gmail.com
MAIL_FROM_NAME="Al NAHDA Agency"

# --- Admin seed account (only used the first time the DB is set up) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
